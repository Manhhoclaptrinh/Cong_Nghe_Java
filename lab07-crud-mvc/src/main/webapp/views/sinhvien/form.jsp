<%@ page contentType="text/html;charset=UTF-8" %><h2>${empty sinhVien ? "Thêm" : "Sửa"} SinhVien</h2><% if("invalid".equals(request.getParameter("error"))){ %><p style="color:red">Dữ liệu không hợp lệ.</p><% } %><form method="post" action="${pageContext.request.contextPath}/sinh-vien"><input type="hidden" name="id" value="${sinhVien.id}"><p>Mã: <input name="ma" value="${sinhVien.ma}" required></p><p>Họ tên: <input name="hoTen" value="${sinhVien.hoTen}" required></p><p>Email: <input name="email" value="${sinhVien.email}" required></p><p>Số điện thoại: <input name="soDienThoai" value="${sinhVien.soDienThoai}" required></p><button>Lưu</button> <a href="${pageContext.request.contextPath}/sinh-vien">Hủy</a></form>