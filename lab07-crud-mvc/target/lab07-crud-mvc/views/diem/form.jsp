<%@ page contentType="text/html;charset=UTF-8" %><h2>Nhập điểm</h2><%if("invalid".equals(request.getParameter("error"))){%><p style="color:red">Điểm phải từ 0 đến 10.</p><%}%><form method="post" action="${pageContext.request.contextPath}/diem"><input type="hidden" name="id" value="${diem.id}"><p>Mã SV: <input name="maSinhVien" value="${diem.maSinhVien}" required></p><p>Họ tên: <input name="hoTen" value="${diem.hoTen}" required></p><p>Chuyên cần: <input type="number" name="chuyenCan" min="0" max="10" step="0.1" value="${diem.chuyenCan}" required></p><p>Giữa kỳ: <input type="number" name="giuaKy" min="0" max="10" step="0.1" value="${diem.giuaKy}" required></p><p>Cuối kỳ: <input type="number" name="cuoiKy" min="0" max="10" step="0.1" value="${diem.cuoiKy}" required></p><button>Lưu</button></form>