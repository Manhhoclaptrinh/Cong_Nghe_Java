<%@ page contentType="text/html;charset=UTF-8" %><h2>${empty sach ? "Thêm" : "Sửa"} Sach</h2><% if("invalid".equals(request.getParameter("error"))){ %><p style="color:red">Dữ liệu không hợp lệ.</p><% } %><form method="post" action="${pageContext.request.contextPath}/sach"><input type="hidden" name="id" value="${sach.id}"><p>Mã sách: <input name="maSach" value="${sach.maSach}" required></p><p>Tên sách: <input name="tenSach" value="${sach.tenSach}" required></p><p>Tác giả: <input name="tacGia" value="${sach.tacGia}" required></p><p>Thể loại: <input name="theLoai" value="${sach.theLoai}" required></p><p>Giá: <input name="gia" value="${sach.gia}" required></p><button>Lưu</button> <a href="${pageContext.request.contextPath}/sach">Hủy</a></form>