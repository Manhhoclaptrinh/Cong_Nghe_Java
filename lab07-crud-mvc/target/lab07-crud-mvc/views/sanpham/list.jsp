<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Danh sách SanPham</h2><form><input name="keyword" value="${param.keyword}" placeholder="Tìm kiếm"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/san-pham?action=new">+ Thêm</a> | <a href="${pageContext.request.contextPath}/">Trang chủ</a></p><table border="1" cellpadding="7"><tr><th>ID</th><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Giá</th><th>Số lượng</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsSanPham}"><tr><td>${x.id}</td><td>${sanPham.ma}</td><td>${sanPham.ten}</td><td>${sanPham.moTa}</td><td>${sanPham.gia}</td><td>${sanPham.soLuong}</td><td><a href="${pageContext.request.contextPath}/san-pham?action=detail&id=${x.id}">Xem</a> | <a href="${pageContext.request.contextPath}/san-pham?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/san-pham?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a><br><a href="${pageContext.request.contextPath}/cart?action=add&id=${x.id}">Thêm giỏ</a></td></tr></c:forEach></table><div style="margin-top:15px">Trang ${currentPage} / ${totalPages} <c:if test="${currentPage>1}"><a href="?page=${currentPage-1}&keyword=${keyword}">← Trước</a></c:if><c:if test="${currentPage<totalPages}"><a href="?page=${currentPage+1}&keyword=${keyword}">Sau →</a></c:if></div>