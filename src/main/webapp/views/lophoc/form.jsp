<%@ page contentType="text/html;charset=UTF-8" %><h2>${empty lopHoc ? "Thêm" : "Sửa"} LopHoc</h2><% if("invalid".equals(request.getParameter("error"))){ %><p style="color:red">Dữ liệu không hợp lệ.</p><% } %><form method="post" action="${pageContext.request.contextPath}/lop-hoc"><input type="hidden" name="id" value="${lopHoc.id}"><p>Mã lớp: <input name="maLop" value="${lopHoc.maLop}" required></p><p>Tên lớp: <input name="tenLop" value="${lopHoc.tenLop}" required></p><p>Cố vấn học tập: <input name="coVanHocTap" value="${lopHoc.coVanHocTap}" required></p><p>Số lượng SV: <input name="soLuongSinhVien" value="${lopHoc.soLuongSinhVien}" required></p><button>Lưu</button> <a href="${pageContext.request.contextPath}/lop-hoc">Hủy</a></form>