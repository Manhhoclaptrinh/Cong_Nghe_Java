<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Danh sách LopHoc</h2><form><input name="keyword" value="${param.keyword}" placeholder="Tìm kiếm"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/lop-hoc?action=new">+ Thêm</a> | <a href="${pageContext.request.contextPath}/">Trang chủ</a></p><table border="1" cellpadding="7"><tr><th>ID</th><th>Mã lớp</th><th>Tên lớp</th><th>Cố vấn học tập</th><th>Số lượng SV</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsLopHoc}"><tr><td>${x.id}</td><td>${lopHoc.maLop}</td><td>${lopHoc.tenLop}</td><td>${lopHoc.coVanHocTap}</td><td>${lopHoc.soLuongSinhVien}</td><td><a href="${pageContext.request.contextPath}/lop-hoc?action=detail&id=${x.id}">Xem</a> | <a href="${pageContext.request.contextPath}/lop-hoc?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/lop-hoc?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><div style="margin-top:15px">Trang ${currentPage} / ${totalPages} <c:if test="${currentPage>1}"><a href="?page=${currentPage-1}&keyword=${keyword}">← Trước</a></c:if><c:if test="${currentPage<totalPages}"><a href="?page=${currentPage+1}&keyword=${keyword}">Sau →</a></c:if></div>