<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Danh sách Sach</h2><form><input name="keyword" value="${param.keyword}" placeholder="Tìm kiếm"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/sach?action=new">+ Thêm</a> | <a href="${pageContext.request.contextPath}/">Trang chủ</a></p><table border="1" cellpadding="7"><tr><th>ID</th><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Giá</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsSach}"><tr><td>${x.id}</td><td>${sach.maSach}</td><td>${sach.tenSach}</td><td>${sach.tacGia}</td><td>${sach.theLoai}</td><td>${sach.gia}</td><td><a href="${pageContext.request.contextPath}/sach?action=detail&id=${x.id}">Xem</a> | <a href="${pageContext.request.contextPath}/sach?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/sach?action=delete&id=${x.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><div style="margin-top:15px">Trang ${currentPage} / ${totalPages} <c:if test="${currentPage>1}"><a href="?page=${currentPage-1}&keyword=${keyword}">← Trước</a></c:if><c:if test="${currentPage<totalPages}"><a href="?page=${currentPage+1}&keyword=${keyword}">Sau →</a></c:if></div>