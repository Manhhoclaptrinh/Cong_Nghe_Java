<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Giỏ hàng Session</h2><c:choose><c:when test="${empty cart}"><p>Giỏ hàng trống.</p></c:when><c:otherwise><table border="1" cellpadding="7"><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr><c:set var="total" value="0"/><c:forEach var="i" items="${cart}"><tr><td>${i.sanPham.ten}</td><td>${i.sanPham.gia}</td><td><form method="get"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${i.sanPham.id}"><input type="number" name="soLuong" value="${i.soLuong}" min="1"><button>Cập nhật</button></form></td><td>${i.thanhTien}</td><td><a href="${pageContext.request.contextPath}/cart?action=remove&id=${i.sanPham.id}">Xóa</a></td></tr><c:set var="total" value="${total+i.thanhTien}"/></c:forEach><tr><th colspan="3">Tổng</th><th>${total}</th><th></th></tr></table></c:otherwise></c:choose><p><a href="${pageContext.request.contextPath}/san-pham">← Sản phẩm</a></p>