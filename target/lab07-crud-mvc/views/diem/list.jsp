<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Quản lý điểm</h2><p><a href="${pageContext.request.contextPath}/diem?action=new">+ Nhập điểm</a> | <a href="${pageContext.request.contextPath}/">Trang chủ</a></p><table border="1" cellpadding="7"><tr><th>Mã SV</th><th>Họ tên</th><th>Chuyên cần</th><th>Giữa kỳ</th><th>Cuối kỳ</th><th>Tổng kết</th><th>Xếp loại</th><th>Thao tác</th></tr><c:forEach var="d" items="${dsDiem}"><tr><td>${d.maSinhVien}</td><td>${d.hoTen}</td><td>${d.chuyenCan}</td><td>${d.giuaKy}</td><td>${d.cuoiKy}</td><td>${d.tongKet}</td><td>${d.xepLoai}</td><td><a href="${pageContext.request.contextPath}/diem?action=edit&id=${d.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/diem?action=delete&id=${d.id}">Xóa</a></td></tr></c:forEach></table>