<%@ page contentType="text/html;charset=UTF-8" %><h2>${empty sanPham ? "Thêm" : "Sửa"} SanPham</h2><% if("invalid".equals(request.getParameter("error"))){ %><p style="color:red">Dữ liệu không hợp lệ.</p><% } %><form method="post" action="${pageContext.request.contextPath}/san-pham"><input type="hidden" name="id" value="${sanPham.id}"><p>Mã: <input name="ma" value="${sanPham.ma}" required></p><p>Tên: <input name="ten" value="${sanPham.ten}" required></p><p>Mô tả: <input name="moTa" value="${sanPham.moTa}" required></p><p>Giá: <input name="gia" value="${sanPham.gia}" required></p><p>Số lượng: <input name="soLuong" value="${sanPham.soLuong}" required></p><button>Lưu</button> <a href="${pageContext.request.contextPath}/san-pham">Hủy</a></form>